# Copy to .env and fill in. Both values come from Supabase: Project Settings -> API.
# They are safe to ship in the browser; row-level security is what protects the data.
# Leave them unset (or as these placeholders) to run on the localStorage demo data instead.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: force the localStorage demo data even when the two values above are set.
# VITE_DATA_SOURCE=mock
